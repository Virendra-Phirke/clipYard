{
  "rules": {
    "rooms": {
      "$roomId": {
        ".write": false,
        "meta": {
          ".read": "auth != null && auth.token.roomId === $roomId"
        },
        "presence": {
          ".read": "auth != null && auth.token.roomId === $roomId"
        },
        "clip": {
          "updatedAt": {
            ".read": "auth != null && auth.token.roomId === $roomId"
          }
        }
      }
    }
  }
}
