{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && auth.token.roomId === $roomId",
        ".write": false,
        "meta": {
          ".read": "auth != null && auth.token.roomId === $roomId"
        },
        "presence": {
          ".read": "auth != null && auth.token.roomId === $roomId",
          "$uid": {
            ".write": "auth != null && auth.token.roomId === $roomId && auth.uid === $uid"
          }
        },
        "clip": {
          ".read": "auth != null && auth.token.roomId === $roomId",
          "updatedAt": {
            ".read": "auth != null && auth.token.roomId === $roomId"
          }
        },
        "signaling": {
          "$targetUid": {
            ".read": "auth != null && auth.token.roomId === $roomId && auth.uid === $targetUid",
            ".write": "auth != null && auth.token.roomId === $roomId && auth.uid === $targetUid",
            "$senderUid": {
              ".write": "auth != null && auth.token.roomId === $roomId && (auth.uid === $senderUid || auth.uid === $targetUid)"
            }
          }
        }
      }
    }
  }
}
