{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && auth.token.roomId == $roomId",
        "meta": {
          ".write": "auth != null && auth.token.roomId == $roomId && auth.token.role == 'host'",
          ".validate": "newData.hasChildren(['hostUid', 'status']) && newData.child('hostUid').val() == data.child('hostUid').val() && (newData.child('status').val() == 'open' || newData.child('status').val() == 'closed')"
        },
        "clip": {
          ".write": "auth != null && auth.token.roomId == $roomId && newData.hasChildren(['text']) && newData.child('text').isString() && newData.child('text').val().length <= 100000",
          ".validate": "newData.hasChildren(['text', 'updatedAt'])"
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.token.roomId == $roomId && auth.uid == $uid",
            ".validate": "newData.hasChildren(['lastSeen'])"
          }
        }
      }
    }
  }
}
